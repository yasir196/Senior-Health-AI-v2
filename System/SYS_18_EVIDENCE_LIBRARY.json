{
  "module": "evidence_library_manager",
  "version": "1.1",
  "storage_root": "Evidence/",
  "core_files": {
    "source_library": "Evidence/evidence_sources.csv",
    "claim_registry": "Evidence/claim_registry.csv",
    "topic_index": "Evidence/topic_index.md",
    "review_queue": "Evidence/review_queue.csv",
    "readme": "Evidence/README.md"
  },
  "source_schema": ["source_id","topic_tags","condition_tags","source_title","authors_or_body","year","url","evidence_tier","source_type","key_finding","supports_claims","limitations","contraindications_or_cautions","last_checked","status","used_in_projects"],
  "claim_schema": ["claim_id","claim_text","approved_wording","topic_tags","source_ids","evidence_tier_floor","claim_strength","allowed_context","required_caveats","forbidden_wording","last_medical_review","status","evidence_applicability_type","material_source_ids","study_population","target_population","senior_specific","extrapolation_caveat","population_metadata_status","source_identity_status"],
  "evidence_applicability_types": {
    "precedence": ["outcome_study","guideline","descriptive_compositional"],
    "derivation": "Use the highest-precedence type among materially supporting sources.",
    "anti_downgrade_rule": "A lower-precedence type cannot be selected to relax population requirements.",
    "unmapped_source_type_action": "block"
  },
  "population_metadata_status_values": ["complete","metadata_incomplete"],
  "source_identity_status_values": ["unresolved","manually_confirmed"],
  "source_identity_status_reserved": ["resolver_confirmed"],
  "type_governed_population_rules": {
    "outcome_study": {"study_population":"required when metadata complete","target_population":"required","senior_specific":"required boolean when metadata complete","extrapolation_caveat":"required for non-senior evidence used for a senior-facing outcome"},
    "guideline": {"study_population":"null","target_population":"required","senior_specific":"required boolean based on explicit guideline scope","extrapolation_caveat":"nullable"},
    "descriptive_compositional": {"study_population":"null","target_population":"required","senior_specific":"null","extrapolation_caveat":"null"}
  },
  "null_semantics": "Nulls are type-governed; there is no generic null escape.",
  "metadata_incomplete_rule": "Population metadata must come from an explicit recorded source statement or a manually confirmed source record. Do not infer missing values from source type, topic, or claim wording.",
  "reuse_rule": "Reused claims inherit these fields from claim_registry.csv. Missing population metadata is not guessed.",
  "approved_status_values": ["approved","needs_review","retired","do_not_use"],
  "claim_strength_values": ["strong","moderate","limited","preliminary"],
  "validation_rules": [
    {"id":"EV1","rule":"approved_sources_must_be_tier_1_to_4","severity":"block"},
    {"id":"EV2","rule":"claims_must_map_to_approved_source_ids","severity":"block"},
    {"id":"EV3","rule":"claims_require_approved_and_forbidden_wording","severity":"block"},
    {"id":"EV4","rule":"elevated_scrutiny_claims_require_caveats","severity":"block"},
    {"id":"EV5","rule":"guidelines_require_last_checked_and_review_cadence","severity":"warn"},
    {"id":"EV6","rule":"library_reuse_cannot_bypass_project_research_or_fact_check","severity":"block"},
    {"id":"EV7","rule":"library_cannot_override_SYS_09","severity":"block"},
    {"id":"EV8","rule":"governing_evidence_type_follows_material_source_precedence","severity":"block"},
    {"id":"EV9","rule":"population_nulls_follow_type_governed_rules","severity":"block"}
  ],
  "agent_usage": {
    "research_agent": ["search topic_index before external research","reuse approved source_ids only after checking exact claim support","add new approved sources after project medical gate passes"],
    "medical_agent": ["cross_check project claims against claim_registry","flag stale or mismatched sources in review_queue","record final pass_fail in 13_fact_check_log.md"]
  },
  "immutability_boundary": {
    "cannot_modify": ["System/SYS_09_MEDICAL_RULE_ENGINE.json"],
    "cannot_override": ["medical_gate_failures","tier_requirements","clinician_caveats"],
    "note": "The Evidence Library is a reusable evidence index, not a medical authority above SYS_09."
  }
}
