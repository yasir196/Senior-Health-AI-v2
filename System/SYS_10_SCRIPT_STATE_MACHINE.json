{
  "module": "script_state_machine",
  "version": "1.3",
  "objective": {
    "primary": "Optimize Average View Duration while preserving medical accuracy and trust.",
    "principle": "Optimize retention within medical accuracy. Where retention and safety or evidence boundaries conflict, safety and evidence take priority. Scripts must create curiosity, momentum, and visual rhythm instead of presenting information only sequentially."
  },
  "default_runtime": {
    "authority": "config.json is the canonical runtime authority. Read narration_words_per_minute, target_runtime_minutes, and target_runtime_range_minutes from config.json. The values below are inert fallbacks for use only when config.json supplies no runtime keys; they must never override config.json and must never be used to compute a second narration-word floor.",
    "canonical_keys": [
      "narration_words_per_minute",
      "target_runtime_minutes",
      "target_runtime_range_minutes"
    ],
    "fallback_only": true,
    "fallback_target_minutes": 20,
    "fallback_minimum_minutes": 18,
    "fallback_maximum_minutes": 23,
    "fallback_estimated_speaking_rate_wpm": {
      "default": 145,
      "acceptable_range": [
        130,
        160
      ]
    },
    "fallback_estimated_word_count_range_default": {
      "min_words_at_130_wpm": 2340,
      "target_words_at_145_wpm": 2900,
      "max_words_at_160_wpm": 3680
    },
    "override_policy": "Runtime is ADVISORY ONLY — NON-BLOCKING. A script outside the canonical config.json runtime window is reported as informational metadata and never fails QA for runtime reasons. Runtime must never force restoration of repetition or creation of low-value factual material; see canonical_runtime_lock."
  },
  "states": [
    {
      "state": "HOOK",
      "t": "0-45s",
      "exit_condition": "thumbnail_promise_answered_and_concrete_value_delivered",
      "next": "BODY"
    },
    {
      "state": "BODY",
      "t": "bulk",
      "exit_condition": "all_items_delivered",
      "embedded_beats": [
        "stakes",
        "credibility",
        "triage_when_required"
      ],
      "rules": [
        "mandatory_triage_before_movement_or_action",
        "evidence_attaches_to_supported_item",
        "no_standalone_evidence_block_before_body"
      ],
      "next": "RECAP"
    },
    {
      "state": "RECAP",
      "t": "final",
      "exit_condition": "strongest_payoff_restated_and_cta",
      "next": "END"
    }
  ],
  "invariants": [
    {
      "id": "I1",
      "rule": "open_loops_adaptive_and_every_opened_loop_closed",
      "severity": "advisory"
    },
    {
      "id": "I2",
      "rule": "item_order_serves_viewer_strongest_may_lead_for_thumbnail_payoff",
      "severity": "advisory"
    },
    {
      "id": "I3",
      "rule": "strongest_item_last_and_pre_teased_optional_never_delay_thumbnail_answer",
      "severity": "advisory"
    },
    {
      "id": "I4",
      "rule": "one_actionable_takeaway_min",
      "severity": "block"
    },
    {
      "id": "I5",
      "rule": "payoff_matches_title",
      "severity": "block"
    },
    {
      "id": "I6",
      "rule": "caveat_present",
      "severity": "block"
    },
    {
      "id": "I7",
      "rule": "runtime_target_advisory_non_blocking",
      "severity": "advisory"
    },
    {
      "id": "I8",
      "rule": "every_section_adds_new_value",
      "severity": "block"
    },
    {
      "id": "I9",
      "rule": "no_padding_to_hit_runtime",
      "severity": "block"
    },
    {
      "id": "I10",
      "rule": "runtime_metrics_block_present",
      "severity": "block"
    },
    {
      "id": "I11",
      "rule": "channel_name_placeholder_or_generic_cta",
      "severity": "block"
    },
    {
      "id": "I12",
      "rule": "presenter_name_placeholders_required",
      "severity": "block"
    },
    {
      "id": "I13",
      "rule": "first_30_seconds_retention_hook_complete",
      "severity": "block"
    },
    {
      "id": "I14",
      "rule": "curiosity_loops_adaptive_only_for_real_questions_and_every_opened_loop_closed",
      "severity": "advisory"
    },
    {
      "id": "I15",
      "rule": "pattern_interrupt_every_2_to_3_minutes",
      "severity": "block"
    },
    {
      "id": "I16",
      "rule": "mini_stories_optional_evidence_serving_no_fixed_cadence",
      "severity": "advisory"
    },
    {
      "id": "I17",
      "rule": "visual_cue_at_major_transitions",
      "severity": "block"
    },
    {
      "id": "I18",
      "rule": "micro_recaps_strategic_only_no_time_fill",
      "severity": "advisory"
    },
    {
      "id": "I19",
      "rule": "major_sections_end_with_next_section_tease",
      "severity": "block"
    },
    {
      "id": "I20",
      "rule": "final_payoff_contains_biggest_lesson_safest_takeaway_practical_action",
      "severity": "block"
    },
    {
      "id": "I21",
      "rule": "cta_after_recap_not_before",
      "severity": "block"
    },
    {
      "id": "I22",
      "rule": "retention_report_present",
      "severity": "block"
    },
    {
      "id": "I23",
      "rule": "first_practical_value_by_3_00",
      "severity": "block",
      "exception": "mandatory_triage",
      "exception_requires": "Reason recorded in the outline under 'Time to first practical value'."
    }
  ],
  "retention_engine": {
    "hook_first_30_seconds": {
      "required_elements": [
        "immediate_viewer_self_identification",
        "one_concrete_promised_value",
        "one_promise",
        "one_emotional_reason_to_continue"
      ],
      "prohibited": [
        "withholding_thumbnail_answer",
        "explaining_everything_immediately",
        "soft_greeting_before_tension"
      ],
      "optional_elements": [
        "one_surprising_statement",
        "one_open_curiosity_loop"
      ],
      "withhold_policy": "withhold_depth_not_answer"
    },
    "open_loops": {
      "cadence": "adaptive",
      "open_only_when_real_question_exists": true,
      "must_eventually_close": true,
      "examples": [
        "That isn't even the biggest mistake...",
        "But something even more important comes later.",
        "Rule #6 is where most people accidentally go wrong.",
        "The food everyone talks about isn't actually the first thing to fix."
      ]
    },
    "pattern_interrupts": {
      "cadence_minutes": [
        2,
        3
      ],
      "maximum_uninterrupted_explanation_minutes": 3,
      "allowed_types": [
        "surprising_fact",
        "myth_vs_reality",
        "comparison",
        "mini_story",
        "practical_demonstration",
        "visual_question",
        "common_mistake",
        "checklist"
      ]
    },
    "mini_stories": {
      "required": false,
      "cadence": "none_fixed",
      "purpose": "Optional and evidence-serving; use only when it clarifies approved content.",
      "examples": [
        "Imagine two adults, both 72 years old...",
        "Many people do this every morning without realizing..."
      ],
      "rules": [
        "stories_must_remain_educational",
        "hypothetical_stories_must_be_labeled_hypothetical",
        "no_fictional_medical_outcomes"
      ]
    },
    "visual_cues": {
      "required_at_major_transitions": true,
      "format": "[Visual Cue]",
      "examples": [
        "Show food labels.",
        "Compare two breakfast plates.",
        "Zoom into kidney illustration."
      ],
      "consumer": "Production_Agent"
    },
    "micro_recaps": {
      "cadence": "strategic",
      "max_seconds": 20,
      "purpose": "Use only when strategically justified; never use recaps to fill time."
    },
    "section_endings": {
      "must_tease_next_section": true,
      "example": "But potassium isn't the nutrient most people misunderstand."
    },
    "final_payoff": {
      "must_feel_rewarding": true,
      "required_elements": [
        "biggest_lesson",
        "safest_takeaway",
        "practical_action_for_tomorrow"
      ],
      "abrupt_ending": "prohibited"
    },
    "cta": {
      "placement": "after_recap_or_inside_final_payoff",
      "must_not_interrupt_education": true,
      "preferred_phrase": "If you enjoy evidence-based senior health guidance..."
    }
  },
  "section_value_requirements": {
    "purpose": "Prevent padding and repetition by requiring every section to add a distinct value type.",
    "allowed_value_types": [
      "evidence",
      "mechanism",
      "myth",
      "comparison",
      "practical_tip",
      "warning",
      "recap"
    ],
    "rule": "Every outline section and final script section must be tagged with at least one allowed value type. Sections that repeat previous information without a new value type fail validation."
  },
  "required_final_script_metrics": {
    "must_appear_at_end": true,
    "fields": [
      "Estimated Runtime",
      "Estimated Word Count",
      "Average Speaking Rate",
      "Runtime Advisory"
    ],
    "runtime_advisory_value": "ADVISORY ONLY — NON-BLOCKING"
  },
  "required_retention_report": {
    "must_appear_at_end": true,
    "fields": [
      "Estimated AVD Potential",
      "Hook Strength /10",
      "Curiosity Loops",
      "Pattern Interrupts",
      "Mini Stories",
      "Visual Cue Count",
      "Micro Recaps",
      "Estimated Engagement",
      "Weakest Section",
      "Strongest Section",
      "Time to First Practical Value"
    ]
  },
  "placeholder_policy": {
    "channel_name": {
      "placeholder": "{{CHANNEL_NAME}}",
      "empty_value_fallback": "Use a generic subscribe CTA without naming the channel.",
      "hardcoded_channel_names": "prohibited"
    },
    "presenter_names": {
      "host_placeholder": "{{HOST_NAME}}",
      "host_title_placeholder": "{{HOST_TITLE}}",
      "doctor_placeholder": "{{DOCTOR_NAME}}",
      "doctor_placeholder_condition": "doctor_mode true only",
      "hardcoded_presenter_names": "prohibited"
    },
    "clinician_boundary": {
      "when_doctor_mode_false": "Never describe or imply the host is a licensed clinician, doctor, or medical professional."
    }
  },
  "transition_style": "bridge_via_reteased_loop",
  "engagement_devices": [
    "second_person_address",
    "rhetorical_questions",
    "physical_participation_prompts",
    "symptom_checklists",
    "open_curiosity_loops",
    "pattern_interrupts",
    "mini_stories",
    "visual_cues",
    "micro_recaps",
    "section_teasers"
  ],
  "value_add_requirement": {
    "min_actionable_takeaways": 1,
    "must_be_evidence_backed": true,
    "payoff_must_match_title": true,
    "bait_and_switch": "prohibited",
    "padding": "prohibited",
    "each_section_must_add": [
      "evidence",
      "mechanism",
      "myth",
      "comparison",
      "practical_tip",
      "warning",
      "recap"
    ]
  },
  "qa_failure_rules": {
    "missing_runtime_metrics_block": "fail",
    "hardcoded_channel_name": "fail",
    "hardcoded_presenter_name": "fail",
    "padding_or_repetitive_sections": "fail",
    "unclosed_curiosity_loops": "fail",
    "missing_pattern_interrupts": "fail",
    "missing_visual_cues": "fail",
    "abrupt_ending": "fail",
    "cta_before_recap": "fail",
    "missing_retention_report": "fail",
    "runtime_shortfall_with_exhausted_source_pool": "escalate as SOURCE_POOL_EXHAUSTED; do not request Writer redevelopment of the same pool",
    "first_practical_value_after_3_00_without_recorded_triage_reason": "fail",
    "thumbnail_answer_withheld_from_opening": "fail"
  },
  "canonical_runtime_lock": {
    "rule": "Every stage derives narration-word targets from the single canonical runtime profile in config.json. No stage may introduce an independent WPM or minute window.",
    "runtime_pass_condition": "Runtime is ADVISORY ONLY — NON-BLOCKING. Report projected narration words against the canonical config.json range as informational metadata only; runtime does not produce PASS/FAIL and must not request Writer redevelopment for runtime reasons.",
    "prohibited": [
      "Requesting new factual material solely to approach a target or midpoint.",
      "Restoring repetition, recaps, disclaimers, analogies, or hypotheticals to regain words.",
      "Computing a narration-word floor from any WPM other than the canonical configured value."
    ],
    "source_pool_exhaustion": "If projected narration words fall below the canonical minimum AND every remaining beat carries a valid approved source trace AND no unused approved source material remains, the cause is SOURCE_POOL_EXHAUSTED. Report it as a runtime-configuration escalation for a human decision. Do NOT route the same exhausted pool back to Writer/Outline for another redevelopment cycle."
  }
}
